# Local dev only — copy to `.env` in the project root.
# The Python API finds it via python-dotenv's find_dotenv(), which walks up
# from the app directory. Docker does NOT read this file: it uses
# infra/env/python.env instead (see infra/env/python.env.example).

# Get a free key at https://api.nasa.gov/ ("DEMO_KEY" works, rate-limited)
NASA_API_KEY=DEMO_KEY

RUST_ENGINE_URL=http://localhost:8080

MONGO_URI=mongodb://localhost:27017
MONGO_DB=astroforge_db

LOG_DIRECTORY=./logs
REQUEST_TIMEOUT=30

# true = Flask debug server with auto-reload, bound to 127.0.0.1 only
DEBUG=true
